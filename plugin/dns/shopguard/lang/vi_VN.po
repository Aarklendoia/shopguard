msgid "the cron job could not be updated."
msgstr "không thể cập nhật tác vụ cron."

msgid "Enter a domain name."
msgstr "Nhập một tên miền."

msgid "Enable"
msgstr "Bật"

msgid "Send the domains resolved by Unbound to the worker. Only domain names are sent, never client addresses."
msgstr "Gửi cho worker các tên miền do Unbound phân giải. Chỉ gửi tên miền, không bao giờ gửi địa chỉ máy khách."

msgid "Worker URL"
msgstr "URL của worker"

msgid "http://htpc.lan:8080"
msgstr "http://htpc.lan:8080"

msgid "Base URL of the shopguard-worker container."
msgstr "URL gốc của container shopguard-worker."

msgid "Token"
msgstr "Token"

msgid "SHOPGUARD_TOKEN of the worker."
msgstr "SHOPGUARD_TOKEN của worker."

msgid "Mode"
msgstr "Chế độ"

msgid "Observe only: suspicious domains are listed here. Block: the domains scoring at least the threshold, with their subdomains, are also blocked by Unbound (answered NXDOMAIN, updated every 5 minutes). They appear in Reporting -> Unbound DNS as blocked by ShopGuard."
msgstr "Chỉ quan sát: các tên miền đáng ngờ được liệt kê ở đây. Chặn: các tên miền có điểm đạt ngưỡng, cùng các tên miền con, cũng bị Unbound chặn (trả lời NXDOMAIN, cập nhật mỗi 5 phút). Chúng xuất hiện trong Báo cáo -> Unbound DNS là bị ShopGuard chặn."

msgid "Score threshold"
msgstr "Ngưỡng điểm"

msgid "Domains scoring at least this value (1 to 100) are considered fake shops."
msgstr "Các tên miền có điểm đạt giá trị này (1 đến 100) được coi là cửa hàng giả."

msgid "Use the worker base URL, e.g. http://htpc.lan:8080 or http://[2001:db8::10]:8080."
msgstr "Dùng URL gốc của worker, ví dụ http://htpc.lan:8080 hoặc http://[2001:db8::10]:8080."

msgid "The token is the SHOPGUARD_TOKEN of the worker: at least 32 characters."
msgstr "Token là SHOPGUARD_TOKEN của worker: ít nhất 32 ký tự."

msgid "Observe only"
msgstr "Chỉ quan sát"

msgid "Block in Unbound"
msgstr "Chặn trong Unbound"

msgid "Choose a score from 1 to 100."
msgstr "Chọn điểm từ 1 đến 100."

msgid "Reachable (version %s)"
msgstr "Truy cập được (phiên bản %s)"

msgid "Unreachable"
msgstr "Không truy cập được"

msgid "%s domains blocked in Unbound (being applied…)"
msgstr "%s tên miền bị chặn trong Unbound (đang áp dụng…)"

msgid "%s domains blocked in Unbound"
msgstr "%s tên miền bị chặn trong Unbound"

msgid "Observe only: nothing blocked"
msgstr "Chỉ quan sát: không chặn gì"

msgid "Disabled"
msgstr "Đã tắt"

msgid "Not run yet"
msgstr "Chưa chạy"

msgid "%s: %s new domains sent"
msgstr "%s: đã gửi %s tên miền mới"

msgid "Settings saved, but:"
msgstr "Đã lưu cài đặt, nhưng:"

msgid "the blocklist could not be updated."
msgstr "không thể cập nhật danh sách chặn."

msgid "Settings applied: %s domains blocked in Unbound."
msgstr "Đã áp dụng cài đặt: %s tên miền bị chặn trong Unbound."

msgid "Unbound applies the changes within 1 to 2 minutes."
msgstr "Unbound áp dụng thay đổi trong vòng 1 đến 2 phút."

msgid "Settings applied: observe only, nothing is blocked."
msgstr "Đã áp dụng cài đặt: chỉ quan sát, không chặn gì."

msgid "Settings applied: ShopGuard is disabled."
msgstr "Đã áp dụng cài đặt: ShopGuard đã tắt."

msgid "ShopGuard"
msgstr "ShopGuard"

msgid "The decision was not saved."
msgstr "Quyết định chưa được lưu."

msgid "Saved. Unbound applies it within 1 to 2 minutes."
msgstr "Đã lưu. Unbound áp dụng trong vòng 1 đến 2 phút."

msgid "Saved."
msgstr "Đã lưu."

msgid "marked fake"
msgstr "đánh dấu là giả"

msgid "marked legitimate"
msgstr "đánh dấu là hợp lệ"

msgid "not analyzed yet"
msgstr "chưa phân tích"

msgid "Forget the decision"
msgstr "Quên quyết định"

msgid "No decision yet."
msgstr "Chưa có quyết định nào."

msgid "Signals"
msgstr "Tín hiệu"

msgid "Legitimate: never block"
msgstr "Hợp lệ: không bao giờ chặn"

msgid "Fake shop: always block"
msgstr "Cửa hàng giả: luôn chặn"

msgid "Weight"
msgstr "Trọng số"

msgid "Signal"
msgstr "Tín hiệu"

msgid "Detail"
msgstr "Chi tiết"

msgid "%s — score %s"
msgstr "%s — điểm %s"

msgid "Close"
msgstr "Đóng"

msgid "Verdicts"
msgstr "Kết luận"

msgid "Decisions"
msgstr "Quyết định"

msgid "Settings"
msgstr "Cài đặt"

msgid "Minimum score"
msgstr "Điểm tối thiểu"

msgid "0 (all)"
msgstr "0 (tất cả)"

msgid "blocking threshold"
msgstr "ngưỡng chặn"

msgid "Saving…"
msgstr "Đang lưu…"

msgid "Domain"
msgstr "Tên miền"

msgid "Score"
msgstr "Điểm"

msgid "Last check"
msgstr "Lần kiểm tra cuối"

msgid "Actions"
msgstr "Thao tác"

msgid "Your decisions override the score: a domain marked fake is always blocked (in Block mode), one marked legitimate never is. They are kept by the worker, which also uses them to improve its scoring."
msgstr "Quyết định của bạn được ưu tiên hơn điểm: tên miền bị đánh dấu là giả luôn bị chặn (ở chế độ Chặn), tên miền được đánh dấu là hợp lệ thì không bao giờ. Worker lưu giữ chúng và cũng dùng chúng để cải thiện việc chấm điểm."

msgid "Fake shop"
msgstr "Cửa hàng giả"

msgid "Legitimate"
msgstr "Hợp lệ"

msgid "One domain per line, to report them (HaGeZi, Signal Arnaques)"
msgstr "Mỗi dòng một tên miền, để báo cáo (HaGeZi, Signal Arnaques)"

msgid "Export the fake shops"
msgstr "Xuất các cửa hàng giả"

msgid "Decision"
msgstr "Quyết định"

msgid "Since"
msgstr "Từ"

msgid "Computed score"
msgstr "Điểm đã tính"

msgid "Worker"
msgstr "Worker"

msgid "Status"
msgstr "Trạng thái"

msgid "Domains waiting for analysis"
msgstr "Tên miền đang chờ phân tích"

msgid "Last collection"
msgstr "Lần thu thập cuối"

msgid "Blocking"
msgstr "Chặn"

msgid "Unbound statistics are disabled: enable them in Reporting -> Unbound DNS, Settings tab. ShopGuard reads the domains from there."
msgstr "Thống kê Unbound đang tắt: bật trong Báo cáo -> Unbound DNS, thẻ Cài đặt. ShopGuard đọc tên miền từ đó."

msgid "No worker URL configured."
msgstr "Chưa cấu hình URL của worker."

msgid "Search for part of a domain name."
msgstr "Tìm một phần của tên miền."

msgid "Unexpected answer from the worker."
msgstr "Phản hồi không mong đợi từ worker."

msgid "Set the worker URL and token first."
msgstr "Hãy đặt URL và token của worker trước."

msgid "Cannot read the Unbound database: %s"
msgstr "Không thể đọc cơ sở dữ liệu Unbound: %s"

msgid "Blocklist not updated, the previous one stays: %s"
msgstr "Danh sách chặn chưa được cập nhật, giữ danh sách trước: %s"

msgid "The worker refused the token."
msgstr "Worker đã từ chối token."

msgid "The worker is too old for decisions: update it to 0.9 or later."
msgstr "Worker quá cũ cho quyết định: hãy cập nhật lên 0.9 trở lên."

msgid "Worker error: HTTP %d."
msgstr "Lỗi worker: HTTP %d."

msgid "Worker unreachable: %s"
msgstr "Không truy cập được worker: %s"

msgid "Not a public domain name."
msgstr "Không phải tên miền công khai."

msgid "The decision is fake, legit or none."
msgstr "Quyết định là fake, legit hoặc none."

msgid "Cannot read the configuration: %s"
msgstr "Không thể đọc cấu hình: %s"
