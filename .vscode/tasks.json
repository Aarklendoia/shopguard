{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "worker: test",
            "type": "shell",
            "command": "cargo test",
            "options": { "cwd": "${workspaceFolder}/worker" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "worker: clippy",
            "type": "shell",
            "command": "cargo clippy --all-targets -- -D warnings",
            "options": { "cwd": "${workspaceFolder}/worker" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "worker: run (dev token)",
            "type": "shell",
            "command": "SHOPGUARD_TOKEN=dev-token-0123456789abcdef0123456789 SHOPGUARD_LOG=debug cargo run",
            "options": { "cwd": "${workspaceFolder}/worker" },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "plugin: tests",
            "type": "shell",
            "command": "python3 -I plugin/tests/test_shopguard.py plugin/dns/shopguard/src/opnsense/scripts/OPNsense/ShopGuard/shopguard.py",
            "problemMatcher": []
        }
    ]
}
